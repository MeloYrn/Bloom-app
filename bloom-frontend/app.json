{
  "expo": {
    "name": "bloom-frontend",
    "slug": "bloom-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bloomlogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afriyieee.bloomfrontend",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.afriyieee.bloomfrontend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "8b0a18cd-6f1b-4232-b674-a2a5801f8627"
      }
    }
  }
}
